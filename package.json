{
  "name": "ki-text-analyzer",
  "version": "1.0.0",
  "description": "Statischer lokaler Text-Analyzer mit modularer Stilometrie und SynthID-Referenzprüfung",
  "scripts": {
    "test": "node --test tests/unit/*.test.js tests/contracts/*.test.js",
    "build": "node scripts/build-vendor.js && npm run build:branding && npm run build:licenses",
    "build:licenses": "node scripts/build-licenses.js",
    "start": "node scripts/serve.js",
    "test:browser": "playwright test",
    "check": "node scripts/check.js",
    "build:og-image": "node scripts/build-og-images.js",
    "build:icons": "node scripts/build-icons.js",
    "build:metadata": "node scripts/build-site-metadata.js",
    "build:branding": "npm run build:icons && npm run build:og-image && npm run build:metadata"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marsrakete/ki-text-analyzer.git"
  },
  "license": "Apache-2.0",
  "type": "module",
  "devDependencies": {
    "@babel/parser": "8.0.7",
    "@babel/traverse": "8.0.7",
    "@playwright/test": "1.64.0",
    "@resvg/resvg-js": "2.6.2",
    "esbuild": "0.28.2",
    "jsdom": "30.1.2",
    "prettier": "3.9.10",
    "sharp": "0.35.5"
  },
  "dependencies": {
    "@sctg/sentencepiece-js": "1.3.3",
    "gpt-tokenizer": "4.0.0"
  }
}
